# Pick which AI provider powers the app — "groq" (free, no card) or "anthropic" (paid after trial credit).
MODEL_PROVIDER=groq

# Needed if MODEL_PROVIDER=groq — get a free key at https://console.groq.com (no card required)
GROQ_API_KEY=gsk_your-groq-key-here

# Needed if MODEL_PROVIDER=anthropic — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides — only touch these if Groq's model lineup changes
# (check https://console.groq.com/docs/models if something 404s)
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# ANTHROPIC_MODEL=claude-sonnet-5

# Database — leave DATABASE_URL unset to use SQLite (zero setup, a file
# on disk, great for local dev). Set it to use PostgreSQL instead (real
# concurrent writes, survives redeploys with a managed database):
# DATABASE_URL=postgresql://user:password@localhost:5432/classroom
